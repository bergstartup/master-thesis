kretprobe:schedule {
 if(strncmp(comm,"fio",3) == 0) {
  $entry = nsecs;
  $lastEntry = @pollMeta[pid].0;
  $diff = @pollMeta[pid].1 + ($entry - $lastEntry);
  $count = @pollMeta[pid].2 + 1;
  if($lastEntry == 0) {
   $diff = 0;
   $count = 0;
  }
  @pollMeta[pid] = ($entry, $diff, $count);
 }
}
