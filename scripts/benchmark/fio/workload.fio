[global]
name=${NAME}

time_based=1
runtime=${TIME}
ramp_time=10

bs=4096B
iodepth=${QD}
numjobs=${NPROCESS}

ioengine=io_uring
fixedbufs=1
registerfiles=1
sqthread_poll=1
hipri=1
direct=1

group_reporting=1
filename=${DEVICE}

#per_job_logs=0
#disable_slat=1
#disable_lat=1
#write_bw_log=logs/${NAME}
#write_lat_log=logs/${NAME}
#write_iops_log=logs/${NAME}
#log_avg_msec=1000

[experiment]
readwrite=${WORKLOAD}
