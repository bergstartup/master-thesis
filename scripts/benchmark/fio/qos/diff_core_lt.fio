[global]
name=diff_core_lt
time_based=1
ramp_time=10
runtime=120
bs=4096B
ioengine=io_uring
fixedbufs=1
registerfiles=1
direct=1
filename=/dev/nvme0n2

[latency]
readwrite=write
iodepth=1
prio=${LAT_PRIO}
nice=${LAT_NICE}
cpus_allowed=0

[throughput]
stonewall=${STONEWALL}
prio=${THR_PRIO}
nice=${THR_NICE}
readwrite=read
iodepth=128
cpus_allowed=1
