[global]
name=same_core_lt
time_based=1
ramp_time=10
runtime=120
bs=4096B
ioengine=io_uring
fixedbufs=1
registerfiles=1
direct=1

[latency]
prio=${LPRIO}
nice=${LNICE}
iodepth=1
readwrite=write
cpus_allowed=${LCPU}
filename=${LDEVICE}

[throughput]
stonewall=${STONEWALL}
prio=${TPRIO}
nice=${TNICE}
iodepth=128
readwrite=read
cpus_allowed=${TCPU}
filename=${TDEVICE}
