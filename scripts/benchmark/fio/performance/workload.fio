[global]
name=${NAME}

time_based=1
runtime=${TIME}
ramp_time=10

bs=${REQSIZE}
iodepth=${QD}
numjobs=${NPROCESS}

ioengine=io_uring
fixedbufs=1
registerfiles=1
hipri=${CPOLL}
direct=1
cpus_allowed_policy=split
cpus_allowed=${CPUS}

group_reporting=1
filename=${DEVICE}

per_job_logs=0

[experiment]
readwrite=${WORKLOAD}
